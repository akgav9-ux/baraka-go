generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id   Int     @id @default(autoincrement())
  name String?
}

model Order {
  id          Int    @id @default(autoincrement())

  from        String
  to          String

  fromLat     Float?
  fromLng     Float?
  toLat       Float?
  toLng       Float?

  status      String @default("pending")

  price       Int

  comment     String?

  packageType String? @default("posilka")
  weight      Int?    @default(5)
  urgent      Boolean? @default(false)
  payment     String? @default("cash")
  changeAmount Int?

  courierName String?
  courierId   Int?

  clientName  String?
  clientPhone String?

  createdAt   DateTime @default(now())
  acceptedAt  DateTime?
  
  extraData   String?  // JSON строка для хранения дополнительных данных
}

model Driver {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Restaurant {
  id        Int      @id @default(autoincrement())
  name      String
  category  String
  price     Int
  rating    Float
  image     String
  createdAt DateTime @default(now())
}